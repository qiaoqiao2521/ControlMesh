+                or item.get("stage") not in _DIAGNOSTIC_STAGES
+                or not isinstance(item.get("exception_type"), str)
+                or not item["exception_type"].isidentifier()
+                or len(item["exception_type"]) > 120):
+            return
+        clean = {key: item[key] for key in ("diagnostic", "stage", "exception_type")}
+        for key in ("errno", "status_code", "code"):
+            if type(item.get(key)) is int:
+                clean[key] = item[key]
+        if type(item.get("credential_invalid")) is bool:
+            clean["credential_invalid"] = item["credential_invalid"]
+        print(json.dumps(clean, separators=(",", ":")), file=sys.stderr, flush=True)
+    except (ValueError, TypeError, AttributeError):
+        return  # Never relay raw SDK output, exception bodies or extra fields.
+
+
+def _drain_child_diagnostics(proc, state):
